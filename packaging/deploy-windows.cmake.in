set(bin "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@")
execute_process(
  COMMAND "@SANITY_WINDEPLOYQT@" --release --no-translations --no-compiler-runtime
          "${bin}/podcast-sanity.exe"
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "windeployqt failed: ${result}")
endif()
# Codec dependencies copied by vcpkg's app-local deployment, including their
# transitive dependencies. Qt and the CRT are deployed separately above.
file(GLOB codec_dlls "@CMAKE_CURRENT_BINARY_DIR@/Release/*.dll")
foreach(dll IN LISTS codec_dlls)
  get_filename_component(name "${dll}" NAME)
  if(NOT name MATCHES "^Qt6")
    file(INSTALL "${dll}" DESTINATION "${bin}")
  endif()
endforeach()
